# Copy to terraform.tfvars (gitignored).

budget_email = "you@example.com"

# region                       = "us-west-2"
# project                      = "radagent"
# monthly_budget_usd           = 50
# idle_session_timeout_seconds = 1800
# max_session_lifetime_seconds = 28800
# bedrock_model_ids = [
#   "global.anthropic.claude-sonnet-4-6",
#   "global.anthropic.claude-haiku-4-5-20251001-v1:0",
# ]

# GitHub Actions deploys the agent from this repository's main branch (.github/workflows/main.yml)
# github_repository = "owner/name"
# With immutable OIDC subjects (newer repositories), also the sub claim's prefix:
#   gh api repos/<owner>/<name>/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_oidc_subject_prefix = "repo:owner@<owner id>/name@<repo id>"

# Connect Google in the app's settings (the agent's Drive, Docs and Calendar tools); see agent/README.md
# google_client_id = "<id>.apps.googleusercontent.com"

# The first scripts/deploy-agent.sh passes image_tag (-var image_tag=...). Once the runtime exists, set it here to
# any deployed tag so a plain `terraform apply` keeps the runtime; Terraform ignores the image after creating it.
# image_tag = "<git sha>-<timestamp>"
