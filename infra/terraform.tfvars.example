# GitHub Actions deploys the agent from this repository's main branch (.github/workflows/main.yml)
# github_repository = "owner/name"

# The first scripts/deploy-agent.sh passes image_tag (-var image_tag=...). Once the runtime exists, set it here to
# any deployed tag so a plain `terraform apply` keeps the runtime; Terraform ignores the image after creating it.
# image_tag = "<git sha>-<timestamp>"
