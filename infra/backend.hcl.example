# Copy to backend.hcl (gitignored), or generate it:
#   terraform -chdir=infra/bootstrap output -raw backend_hcl > infra/backend.hcl
# then: terraform -chdir=infra init -backend-config=backend.hcl
bucket       = "radagent-tfstate-123456789012"
key          = "radagent/terraform.tfstate"
region       = "us-west-2"
use_lockfile = true
encrypt      = true
