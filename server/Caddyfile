# Public HTTPS in front of Garage's S3 API; only used with `docker compose --profile public up -d`
# Caddy gets and renews the certificate for S3_DOMAIN itself. Requests are still signed with the S3 key, so TLS is
# what keeps the chats themselves private on the way

{$S3_DOMAIN} {
	request_body {
		max_size 64MB
	}
	# Caddy passes the Host header through unchanged, which S3 request signatures depend on
	reverse_proxy garage:3900
}
