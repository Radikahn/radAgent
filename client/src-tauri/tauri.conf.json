{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "radAgent",
  "version": "0.1.0",
  "identifier": "com.radman.radagent",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "radAgent",
        "width": 1100,
        "height": 750,
        "minWidth": 420,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.amazonaws.com wss://*.amazonaws.com ws://127.0.0.1:8787",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org https://www.google.com https://*.gstatic.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.amazonaws.com wss://*.amazonaws.com ws://127.0.0.1:8787 ws: http://localhost:1420",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org https://www.google.com https://*.gstatic.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
