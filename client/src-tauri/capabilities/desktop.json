{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Capability for the main window on desktop",
  "platforms": ["macOS", "windows", "linux"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-print",
    "opener:default"
  ]
}
